# ===============================================
# ARCHIVO DE EJEMPLO — NO COLOQUES DATOS REALES AQUÍ
# Copia este archivo como .env y coloca tus valores reales:
# cp .env.example .env
# ===============================================

# Clave secreta de encriptación para los archivos de datos
ENCRYPTION_KEY=tu_clave_secreta_aqui

# Credenciales maestras del administrador
ADMIN_USER=tu_usuario_admin
ADMIN_PASSWORD=tu_password_seguro

# Modo de entorno (development | production)
NODE_ENV=production
